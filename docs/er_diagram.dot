digraph ER {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.5, ranksep=1.1, pad=0.3,
         label="EmergencySOS - ER diagram (MySQL 8, InnoDB)  |  PK = primary key, FK = foreign key, UQ = unique",
         labelloc=t, fontsize=18];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#475569", arrowhead=crow, arrowtail=tee, dir=both];
  hospitals [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#cbd5e1"><tr><td colspan="3" bgcolor="#1565c0"><font color="white"><b>hospitals</b></font><br/><font color="#dbeafe" point-size="9">hospital</font></td></tr><tr><td align="left" port="hospital_id"><font color="#b91c1c">PK</font></td><td align="left"><b>hospital_id</b></td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="name"><font color="#b91c1c">UQ</font></td><td align="left">name</td><td align="left"><font color="#64748b">varchar(120)</font></td></tr><tr><td align="left" port="area"> </td><td align="left">area</td><td align="left"><font color="#64748b">varchar(80)</font></td></tr><tr><td align="left" port="latitude"> </td><td align="left">latitude</td><td align="left"><font color="#64748b">decimal(9,6)</font></td></tr><tr><td align="left" port="longitude"> </td><td align="left">longitude</td><td align="left"><font color="#64748b">decimal(9,6)</font></td></tr><tr><td align="left" port="phone"> </td><td align="left">phone</td><td align="left"><font color="#64748b">varchar(20) ?</font></td></tr><tr><td align="left" port="is_lab"> </td><td align="left">is_lab</td><td align="left"><font color="#64748b">bool</font></td></tr><tr><td align="left" port="created_at"> </td><td align="left">created_at</td><td align="left"><font color="#64748b">timestamp</font></td></tr></table>>];
  resources [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#cbd5e1"><tr><td colspan="3" bgcolor="#1565c0"><font color="white"><b>resources</b></font><br/><font color="#dbeafe" point-size="9">shared resource (OS)</font></td></tr><tr><td align="left" port="resource_id"><font color="#b91c1c">PK</font></td><td align="left"><b>resource_id</b></td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="hospital_id"><font color="#b91c1c">FK</font></td><td align="left">hospital_id</td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="resource_type"> </td><td align="left">resource_type</td><td align="left"><font color="#64748b">enum</font></td></tr><tr><td align="left" port="total_units"> </td><td align="left">total_units</td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="available_units"> </td><td align="left">available_units</td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="updated_at"> </td><td align="left">updated_at</td><td align="left"><font color="#64748b">timestamp</font></td></tr></table>>];
  doctors [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#cbd5e1"><tr><td colspan="3" bgcolor="#1565c0"><font color="white"><b>doctors</b></font><br/><font color="#dbeafe" point-size="9">specialist</font></td></tr><tr><td align="left" port="doctor_id"><font color="#b91c1c">PK</font></td><td align="left"><b>doctor_id</b></td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="hospital_id"><font color="#b91c1c">FK</font></td><td align="left">hospital_id</td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="name"> </td><td align="left">name</td><td align="left"><font color="#64748b">varchar(80)</font></td></tr><tr><td align="left" port="specialization"> </td><td align="left">specialization</td><td align="left"><font color="#64748b">enum</font></td></tr><tr><td align="left" port="on_shift"> </td><td align="left">on_shift</td><td align="left"><font color="#64748b">bool</font></td></tr><tr><td align="left" port="max_cases"> </td><td align="left">max_cases</td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="current_cases"> </td><td align="left">current_cases</td><td align="left"><font color="#64748b">int</font></td></tr></table>>];
  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#cbd5e1"><tr><td colspan="3" bgcolor="#1565c0"><font color="white"><b>users</b></font><br/><font color="#dbeafe" point-size="9">login + role</font></td></tr><tr><td align="left" port="user_id"><font color="#b91c1c">PK</font></td><td align="left"><b>user_id</b></td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="username"><font color="#b91c1c">UQ</font></td><td align="left">username</td><td align="left"><font color="#64748b">varchar(40)</font></td></tr><tr><td align="left" port="password_hash"> </td><td align="left">password_hash</td><td align="left"><font color="#64748b">varchar(255)</font></td></tr><tr><td align="left" port="full_name"> </td><td align="left">full_name</td><td align="left"><font color="#64748b">varchar(80)</font></td></tr><tr><td align="left" port="phone"> </td><td align="left">phone</td><td align="left"><font color="#64748b">varchar(20) ?</font></td></tr><tr><td align="left" port="role"> </td><td align="left">role</td><td align="left"><font color="#64748b">enum</font></td></tr><tr><td align="left" port="hospital_id"><font color="#b91c1c">FK</font></td><td align="left">hospital_id</td><td align="left"><font color="#64748b">int ?</font></td></tr><tr><td align="left" port="is_active"> </td><td align="left">is_active</td><td align="left"><font color="#64748b">bool</font></td></tr><tr><td align="left" port="created_at"> </td><td align="left">created_at</td><td align="left"><font color="#64748b">timestamp</font></td></tr><tr><td align="left" port="last_login_at"> </td><td align="left">last_login_at</td><td align="left"><font color="#64748b">timestamp ?</font></td></tr></table>>];
  sos_requests [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#cbd5e1"><tr><td colspan="3" bgcolor="#1565c0"><font color="white"><b>sos_requests</b></font><br/><font color="#dbeafe" point-size="9">process (OS)</font></td></tr><tr><td align="left" port="request_id"><font color="#b91c1c">PK</font></td><td align="left"><b>request_id</b></td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="patient_name"> </td><td align="left">patient_name</td><td align="left"><font color="#64748b">varchar(80)</font></td></tr><tr><td align="left" port="phone"> </td><td align="left">phone</td><td align="left"><font color="#64748b">varchar(20) ?</font></td></tr><tr><td align="left" port="latitude"> </td><td align="left">latitude</td><td align="left"><font color="#64748b">decimal(9,6)</font></td></tr><tr><td align="left" port="longitude"> </td><td align="left">longitude</td><td align="left"><font color="#64748b">decimal(9,6)</font></td></tr><tr><td align="left" port="emergency_type"> </td><td align="left">emergency_type</td><td align="left"><font color="#64748b">enum</font></td></tr><tr><td align="left" port="severity"> </td><td align="left">severity</td><td align="left"><font color="#64748b">tinyint</font></td></tr><tr><td align="left" port="description"> </td><td align="left">description</td><td align="left"><font color="#64748b">varchar(255) ?</font></td></tr><tr><td align="left" port="priority"> </td><td align="left">priority</td><td align="left"><font color="#64748b">tinyint</font></td></tr><tr><td align="left" port="required_resource"> </td><td align="left">required_resource</td><td align="left"><font color="#64748b">enum</font></td></tr><tr><td align="left" port="required_specialist"> </td><td align="left">required_specialist</td><td align="left"><font color="#64748b">enum</font></td></tr><tr><td align="left" port="est_handling_min"> </td><td align="left">est_handling_min</td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="status"> </td><td align="left">status</td><td align="left"><font color="#64748b">enum</font></td></tr><tr><td align="left" port="is_lab"> </td><td align="left">is_lab</td><td align="left"><font color="#64748b">bool</font></td></tr><tr><td align="left" port="user_id"><font color="#b91c1c">FK</font></td><td align="left">user_id</td><td align="left"><font color="#64748b">int ?</font></td></tr><tr><td align="left" port="track_token"><font color="#b91c1c">UQ</font></td><td align="left">track_token</td><td align="left"><font color="#64748b">char(16) ?</font></td></tr><tr><td align="left" port="created_at"> </td><td align="left">created_at</td><td align="left"><font color="#64748b">timestamp</font></td></tr><tr><td align="left" port="updated_at"> </td><td align="left">updated_at</td><td align="left"><font color="#64748b">timestamp</font></td></tr></table>>];
  allocations [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#cbd5e1"><tr><td colspan="3" bgcolor="#1565c0"><font color="white"><b>allocations</b></font><br/><font color="#dbeafe" point-size="9">booking (ACID tx)</font></td></tr><tr><td align="left" port="allocation_id"><font color="#b91c1c">PK</font></td><td align="left"><b>allocation_id</b></td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="request_id"><font color="#b91c1c">FK</font></td><td align="left">request_id</td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="hospital_id"><font color="#b91c1c">FK</font></td><td align="left">hospital_id</td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="resource_id"><font color="#b91c1c">FK</font></td><td align="left">resource_id</td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="doctor_id"><font color="#b91c1c">FK</font></td><td align="left">doctor_id</td><td align="left"><font color="#64748b">int ?</font></td></tr><tr><td align="left" port="score"> </td><td align="left">score</td><td align="left"><font color="#64748b">decimal(6,2) ?</font></td></tr><tr><td align="left" port="distance_km"> </td><td align="left">distance_km</td><td align="left"><font color="#64748b">decimal(7,2) ?</font></td></tr><tr><td align="left" port="travel_min"> </td><td align="left">travel_min</td><td align="left"><font color="#64748b">decimal(6,1) ?</font></td></tr><tr><td align="left" port="distance_source"> </td><td align="left">distance_source</td><td align="left"><font color="#64748b">enum ?</font></td></tr><tr><td align="left" port="status"> </td><td align="left">status</td><td align="left"><font color="#64748b">enum</font></td></tr><tr><td align="left" port="allocated_at"> </td><td align="left">allocated_at</td><td align="left"><font color="#64748b">timestamp</font></td></tr><tr><td align="left" port="expected_end_at"> </td><td align="left">expected_end_at</td><td align="left"><font color="#64748b">timestamp ?</font></td></tr><tr><td align="left" port="released_at"> </td><td align="left">released_at</td><td align="left"><font color="#64748b">timestamp ?</font></td></tr><tr><td align="left" port="release_mode"> </td><td align="left">release_mode</td><td align="left"><font color="#64748b">enum ?</font></td></tr><tr><td align="left" port="ambulance_resource_id"><font color="#b91c1c">FK</font></td><td align="left">ambulance_resource_id</td><td align="left"><font color="#64748b">int ?</font></td></tr><tr><td align="left" port="ambulance_due_at"> </td><td align="left">ambulance_due_at</td><td align="left"><font color="#64748b">timestamp ?</font></td></tr><tr><td align="left" port="ambulance_returned_at"> </td><td align="left">ambulance_returned_at</td><td align="left"><font color="#64748b">timestamp ?</font></td></tr></table>>];
  audit_log [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#cbd5e1"><tr><td colspan="3" bgcolor="#1565c0"><font color="white"><b>audit_log</b></font><br/><font color="#dbeafe" point-size="9">event history</font></td></tr><tr><td align="left" port="log_id"><font color="#b91c1c">PK</font></td><td align="left"><b>log_id</b></td><td align="left"><font color="#64748b">bigint</font></td></tr><tr><td align="left" port="event_type"> </td><td align="left">event_type</td><td align="left"><font color="#64748b">varchar(40)</font></td></tr><tr><td align="left" port="request_id"> </td><td align="left">request_id</td><td align="left"><font color="#64748b">int ?</font></td></tr><tr><td align="left" port="hospital_id"> </td><td align="left">hospital_id</td><td align="left"><font color="#64748b">int ?</font></td></tr><tr><td align="left" port="details"> </td><td align="left">details</td><td align="left"><font color="#64748b">varchar(500) ?</font></td></tr><tr><td align="left" port="user_id"> </td><td align="left">user_id</td><td align="left"><font color="#64748b">int ?</font></td></tr><tr><td align="left" port="created_at"> </td><td align="left">created_at</td><td align="left"><font color="#64748b">timestamp(3)</font></td></tr></table>>];
  request_status_history [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#cbd5e1"><tr><td colspan="3" bgcolor="#1565c0"><font color="white"><b>request_status_history</b></font><br/><font color="#dbeafe" point-size="9">written by triggers</font></td></tr><tr><td align="left" port="history_id"><font color="#b91c1c">PK</font></td><td align="left"><b>history_id</b></td><td align="left"><font color="#64748b">bigint</font></td></tr><tr><td align="left" port="request_id"><font color="#b91c1c">FK</font></td><td align="left">request_id</td><td align="left"><font color="#64748b">int</font></td></tr><tr><td align="left" port="old_status"> </td><td align="left">old_status</td><td align="left"><font color="#64748b">enum ?</font></td></tr><tr><td align="left" port="new_status"> </td><td align="left">new_status</td><td align="left"><font color="#64748b">enum</font></td></tr><tr><td align="left" port="changed_at"> </td><td align="left">changed_at</td><td align="left"><font color="#64748b">timestamp(3)</font></td></tr></table>>];
  resources:resource_id -> allocations:ambulance_resource_id [label="1 : N\non delete cascade"];
  doctors:doctor_id -> allocations:doctor_id [label="1 : N\non delete set null"];
  hospitals:hospital_id -> allocations:hospital_id [label="1 : N\non delete cascade"];
  sos_requests:request_id -> allocations:request_id [label="1 : N\non delete cascade"];
  resources:resource_id -> allocations:resource_id [label="1 : N\non delete cascade"];
  hospitals:hospital_id -> doctors:hospital_id [label="1 : N\non delete cascade"];
  sos_requests:request_id -> request_status_history:request_id [label="1 : N\non delete cascade"];
  hospitals:hospital_id -> resources:hospital_id [label="1 : N\non delete cascade"];
  users:user_id -> sos_requests:user_id [label="1 : N\non delete set null"];
  hospitals:hospital_id -> users:hospital_id [label="1 : N\non delete restrict"];
}